{
  "name": "head-of-tp-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-api-route": "npx openapi-generator-cli generate -i ./route-openapi-spec.yaml -g typescript-fetch -o src/lib/route",
    "generate-api-participant": "npx openapi-generator-cli generate -i ./participant-openapi-spec.yaml -g typescript-fetch -o src/lib/participant",
    "generate-api-device": "npx openapi-generator-cli generate -i ./device-openapi-spec.yaml -g typescript-fetch -o src/lib/device"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@stomp/stompjs": "^7.1.1",
    "@tailwindcss/vite": "^4.1.7",
    "@types/leaflet": "^1.9.18",
    "@types/sockjs-client": "^1.5.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.0",
    "sockjs-client": "^1.6.1",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.20.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.7.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.0.0"
  }
}
